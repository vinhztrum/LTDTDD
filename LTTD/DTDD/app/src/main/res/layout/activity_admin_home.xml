<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- HEADER ADMIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_green"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⌂  NHÀ TRỌ XANH / ADMIN"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Xin chào, Admin!"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bạn đã đăng nhập vào khu vực quản trị"
            android:textColor="@color/text_subtitle_on_green"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- NỘI DUNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:background="@drawable/bg_card_input"
            android:text="✓ Đăng nhập Admin thành công&#10;&#10;Các chức năng quản lý tài khoản, nhà trọ, hóa đơn và báo cáo sẽ được phát triển ở bước tiếp theo."
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- NÚT ĐĂNG XUẤT -->
        <TextView
            android:id="@+id/btnLogoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:text="Đăng xuất"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
