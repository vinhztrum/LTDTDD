    <!-- Viền ngăn cách Bottom Navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <!-- THANH ĐIỀU HƯỚNG DƯỚI 4 TAB (Trang chủ | Hóa đơn | Bảo trì | Hợp đồng) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:id="@+id/navTenantHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/iconTenantHome"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_nav_icon_active" />

            <TextView
                android:id="@+id/tvTenantHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trang chủ"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Hóa đơn -->
        <LinearLayout
            android:id="@+id/navTenantInvoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/iconTenantInvoice"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_nav_icon_inactive" />

            <TextView
                android:id="@+id/tvTenantInvoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hóa đơn"
                android:textColor="@color/text_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Bảo trì -->
        <LinearLayout
            android:id="@+id/navTenantRequest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/iconTenantRequest"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_nav_icon_inactive" />

            <TextView
                android:id="@+id/tvTenantRequest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bảo trì"
                android:textColor="@color/text_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Hợp đồng -->
        <LinearLayout
            android:id="@+id/navTenantContract"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/iconTenantContract"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_nav_icon_inactive" />

            <TextView
                android:id="@+id/tvTenantContract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hợp đồng"
                android:textColor="@color/text_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
